<%
  const tabs = [
    { key: 'dashboard', href: '/', label: '首頁', icon: 'home' },
    { key: 'cashback', href: '/cashback', label: '回饋', icon: 'gift' },
    { key: 'recommend', href: '/recommend', label: '刷哪張', icon: 'bolt', main: true },
    { key: 'transactions', href: '/transactions', label: '交易', icon: 'receipt' },
    { key: 'points', href: '/points', label: '點數', icon: 'star' }
  ];
  const cur = typeof active !== 'undefined' ? active : '';
%>
<%- include('icons') %>
<nav class="topnav" aria-label="主選單">
  <div class="mx-auto flex h-14 max-w-5xl items-center gap-1 px-4">
    <a href="<%= url('/') %>" class="mr-3 flex items-center gap-2 font-bold text-slate-900 dark:text-white">
      <span class="grid h-8 w-8 place-items-center rounded-xl bg-gradient-to-br from-brand-500 to-indigo-600 text-sm text-white">C$</span>
      MyCashback
    </a>
    <% tabs.forEach(function (t) { %>
      <a href="<%= url(t.href) %>" class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 <%= cur === t.key ? 'on' : '' %>"><svg class="i i-sm"><use href="#i-<%= t.icon %>"/></svg><%= t.label %></a>
    <% }) %>
    <div class="flex-1"></div>
    <a href="<%= url('/settings') %>" class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 <%= cur === 'settings' ? 'on' : '' %>"><svg class="i i-sm"><use href="#i-cog"/></svg>設定</a>
  </div>
</nav>
<nav class="tabbar" aria-label="主選單">
  <% tabs.forEach(function (t) { %>
    <a href="<%= url(t.href) %>" class="tab <%= t.main ? 'tab-main' : '' %> <%= cur === t.key ? 'on' : '' %>" <%- cur === t.key ? 'aria-current="page"' : '' %>>
      <% if (t.main) { %><span class="tab-bubble"><svg class="i"><use href="#i-<%= t.icon %>"/></svg></span><% } else { %><svg class="i"><use href="#i-<%= t.icon %>"/></svg><% } %>
      <span><%= t.label %></span>
    </a>
  <% }) %>
</nav>
