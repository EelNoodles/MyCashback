<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="format-detection" content="telephone=no" />
<title><%= typeof title !== 'undefined' ? title : 'Points & Cashback Hub' %></title>

<!-- PWA -->
<link rel="manifest" href="<%= url('/manifest.webmanifest') %>" />
<meta name="theme-color" content="#1a76f5" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Cashback" />
<link rel="apple-touch-icon" href="<%= asset('/icons/icon-192.png') %>" />
<link rel="icon" type="image/png" sizes="192x192" href="<%= asset('/icons/icon-192.png') %>" />
<link rel="icon" type="image/png" sizes="512x512" href="<%= asset('/icons/icon-512.png') %>" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />

<link rel="stylesheet" href="<%= asset('/css/styles.css') %>" />

<!-- Expose BASE_URL to client JS so all fetches honour the prefix. -->
<script>
  window.APP_CONFIG = {
    baseUrl: <%- JSON.stringify(baseUrl || '') %>
  };
</script>
