<!DOCTYPE html>
<html lang="zh-Hant">
<head><%- include('partials/head') %></head>
<body data-auth="1">
  <%- include('partials/nav', { active }) %>
  <header class="appbar">
    <div class="appbar-inner">
      <h1 class="appbar-title">點數</h1>
      <button type="button" class="icon-btn icon-btn-primary" id="newPointBtn" aria-label="新增點數"><svg class="i"><use href="#i-plus"/></svg></button>
    </div>
  </header>

  <main class="page">
    <section class="card card-pad grid grid-cols-3 gap-3">
      <div><div class="stat-label">總價值</div><div class="stat-value money" id="sumValue">—</div></div>
      <div><div class="stat-label">本月獲得</div><div class="stat-value text-emerald-600 dark:text-emerald-400" id="sumEarned">—</div></div>
      <div><div class="stat-label">本月使用</div><div class="stat-value text-rose-600 dark:text-rose-400" id="sumSpent">—</div></div>
    </section>
    <div id="pointList" class="mt-3"></div>
  </main>

  <!-- Point detail -->
  <div class="sheet-root" id="pointSheet" hidden role="dialog" aria-modal="true" aria-labelledby="pdTitle">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet sheet-full sheet-lg">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title" id="pdTitle">點數</h2>
        <button type="button" class="icon-btn" id="pdEdit" aria-label="編輯點數資料"><svg class="i"><use href="#i-pencil"/></svg></button>
        <button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <div class="sheet-body">
        <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/60">
          <div class="stat-label">目前餘額</div>
          <div class="text-3xl font-extrabold tracking-tight money" id="pdBalance">—</div>
          <div class="text-sm muted" id="pdValue"></div>
          <div class="mt-3 grid grid-cols-3 gap-2">
            <button type="button" class="btn btn-sm btn-success" data-change="earn"><svg class="i i-sm"><use href="#i-plus"/></svg>獲得</button>
            <button type="button" class="btn btn-sm bg-rose-600 text-white" data-change="spend">− 使用</button>
            <button type="button" class="btn btn-sm btn-secondary" data-change="set">= 校正</button>
          </div>
        </div>
        <h3 class="section-title"><span>到期提醒</span><button type="button" id="addExpiryBtn">＋ 新增</button></h3>
        <div id="pdExpiries" class="card overflow-hidden"></div>
        <h3 class="section-title"><span>時間軸</span><span class="text-xs font-normal normal-case muted" id="pdMonth"></span></h3>
        <div id="pdTimeline" class="card overflow-hidden"></div>
      </div>
    </div>
  </div>

  <!-- History form -->
  <div class="sheet-root" id="historySheet" hidden role="dialog" aria-modal="true" aria-labelledby="hTitle">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title" id="hTitle">新增紀錄</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <form id="historyForm" class="sheet-body space-y-3" novalidate>
        <input type="hidden" name="hid">
        <div class="seg" id="hTypeSeg">
          <button type="button" data-type="earn">獲得</button>
          <button type="button" data-type="spend">使用</button>
          <button type="button" data-type="set">校正餘額</button>
        </div>
        <label class="field"><span class="label" id="hAmountLabel">數量</span><input name="amount" type="number" inputmode="decimal" min="0" step="0.01" class="input input-lg money" required></label>
        <span class="hint" id="hHint"></span>
        <label class="field"><span class="label">時間</span><input name="occurredAt" type="datetime-local" class="input"></label>
        <label class="field"><span class="label">備註</span><input name="note" class="input" maxlength="500" placeholder="例如：購物累積、折抵"></label>
        <div class="error-box" id="hError" hidden></div>
      </form>
      <div class="sheet-footer">
        <button type="button" class="btn btn-danger !px-3" id="hDelete" hidden aria-label="刪除"><svg class="i"><use href="#i-trash"/></svg></button>
        <button type="button" class="btn btn-secondary flex-1" data-close>取消</button>
        <button type="submit" form="historyForm" class="btn btn-primary flex-[2]">儲存</button>
      </div>
    </div>
  </div>

  <!-- Expiry form -->
  <div class="sheet-root" id="expirySheet" hidden role="dialog" aria-modal="true" aria-labelledby="eTitle">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title" id="eTitle">到期提醒</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <form id="expiryForm" class="sheet-body space-y-3" novalidate>
        <input type="hidden" name="eid">
        <div class="grid grid-cols-2 gap-2">
          <label class="field"><span class="label">到期數量 *</span><input name="amount" type="number" inputmode="decimal" min="0" step="0.01" class="input" required></label>
          <label class="field"><span class="label">到期日 *</span><input name="expiryDate" type="date" class="input" required></label>
        </div>
        <label class="field"><span class="label">備註</span><input name="note" class="input" maxlength="500"></label>
        <span class="hint">每天 21:00 會推播 7 天內到期的點數（需在設定開啟推播）</span>
        <div class="error-box" id="eError" hidden></div>
      </form>
      <div class="sheet-footer">
        <button type="button" class="btn btn-danger !px-3" id="eDelete" hidden aria-label="刪除"><svg class="i"><use href="#i-trash"/></svg></button>
        <button type="button" class="btn btn-secondary flex-1" data-close>取消</button>
        <button type="submit" form="expiryForm" class="btn btn-primary flex-[2]">儲存</button>
      </div>
    </div>
  </div>

  <!-- Point form -->
  <div class="sheet-root" id="pointFormSheet" hidden role="dialog" aria-modal="true" aria-labelledby="pfTitle">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title" id="pfTitle">新增點數</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <form id="pointForm" class="sheet-body space-y-3" novalidate enctype="multipart/form-data">
        <input type="hidden" name="id">
        <label class="field"><span class="label">名稱 *</span><input name="name" class="input" maxlength="120" required placeholder="例如：全聯福利點"></label>
        <label class="field"><span class="label">發行單位</span><input name="issuer" class="input" maxlength="120" placeholder="例如：全聯"></label>
        <label class="field" id="pfBalanceField"><span class="label">目前餘額</span><input name="currentBalance" type="number" inputmode="decimal" min="0" step="0.01" class="input" value="0"></label>
        <label class="field"><span class="label">每點約值（新台幣）</span><input name="valuePerPoint" type="number" inputmode="decimal" min="0" step="0.0001" class="input" placeholder="例如 1；航空哩程約 0.3"><span class="hint">設定後可換算點數總價值；不確定可留空</span></label>
        <label class="field"><span class="label">圖示（選填）</span><input name="image" type="file" accept="image/*" class="block w-full text-sm"></label>
        <label class="field"><span class="label">備註</span><textarea name="note" rows="2" class="textarea"></textarea></label>
        <div class="error-box" id="pfError" hidden></div>
      </form>
      <div class="sheet-footer">
        <button type="button" class="btn btn-danger !px-3" id="pfDelete" hidden aria-label="刪除"><svg class="i"><use href="#i-trash"/></svg></button>
        <button type="button" class="btn btn-secondary flex-1" data-close>取消</button>
        <button type="submit" form="pointForm" class="btn btn-primary flex-[2]">儲存</button>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="<%= asset('/js/points.js') %>"></script>
</body>
</html>
