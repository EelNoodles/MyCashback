<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <%- include('partials/head', { title: title }) %>
</head>
<body class="min-h-screen bg-slate-50 text-slate-800">
  <%- include('partials/nav', { active: active }) %>

  <main class="max-w-6xl mx-auto px-4 py-6 space-y-6">
    <header class="flex items-center justify-between gap-3 flex-wrap">
      <div>
        <h1 class="text-2xl font-semibold">點數時間軸</h1>
        <p class="text-sm text-slate-500">追蹤每筆變動，分析花費/累積</p>
      </div>
      <button id="newPointBtn" class="px-3 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700">+ 新增點數</button>
    </header>

    <!-- Points list as horizontal scroll on mobile, grid on desktop -->
    <section>
      <div id="pointsList" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        <div class="text-sm text-slate-400 col-span-full" data-loading>載入中…</div>
      </div>
    </section>

    <!-- Detail / timeline pane -->
    <section id="timelinePane" class="hidden bg-white rounded-2xl shadow-sm border border-slate-100">
      <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between gap-2">
        <div class="min-w-0">
          <div class="text-sm text-slate-500">當前餘額</div>
          <div class="text-2xl font-semibold truncate" id="tlBalance">—</div>
          <div class="text-xs text-slate-400 truncate" id="tlPointName">—</div>
        </div>
        <div class="flex gap-2 flex-shrink-0">
          <button id="addHistoryBtn" class="px-3 py-1.5 text-xs rounded-lg bg-brand-600 text-white hover:bg-brand-700">+ 紀錄</button>
          <button id="addExpiryBtn" class="px-3 py-1.5 text-xs rounded-lg bg-amber-500 text-white hover:bg-amber-600">⏰ 到期提醒</button>
          <button id="closeTimelineBtn" class="px-3 py-1.5 text-xs rounded-lg border border-slate-300">關閉</button>
        </div>
      </div>

      <div class="px-4 py-3 grid grid-cols-3 gap-3 border-b border-slate-100" id="tlStats">
        <div>
          <div class="text-[10px] uppercase text-slate-400">本月累積</div>
          <div class="text-base font-semibold text-emerald-600" data-tlstat="earned">—</div>
        </div>
        <div>
          <div class="text-[10px] uppercase text-slate-400">本月花費</div>
          <div class="text-base font-semibold text-rose-600" data-tlstat="spent">—</div>
        </div>
        <div>
          <div class="text-[10px] uppercase text-slate-400">本月淨變動</div>
          <div class="text-base font-semibold" data-tlstat="net">—</div>
        </div>
      </div>

      <ol id="timeline" class="relative px-4 py-3 space-y-3 max-h-[60vh] overflow-y-auto">
      </ol>
    </section>
  </main>

  <!-- Modal: Point form -->
  <div id="pointModal" class="hidden fixed inset-0 z-40 bg-black/40 grid place-items-center px-3">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl p-5 animate-slide-up">
      <h3 class="text-lg font-semibold" id="pointModalTitle">新增點數</h3>
      <form id="pointForm" class="mt-3 space-y-3" enctype="multipart/form-data">
        <input type="hidden" name="id" />
        <label class="block">
          <span class="text-xs text-slate-500">名稱 <span class="text-rose-500">*</span></span>
          <input name="name" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </label>
        <label class="block">
          <span class="text-xs text-slate-500">發行單位</span>
          <input name="issuer" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </label>
        <label class="block">
          <span class="text-xs text-slate-500">當前點數 (建立時填入)</span>
          <input name="currentBalance" type="number" step="0.01" min="0" value="0"
                 class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </label>
        <label class="block">
          <span class="text-xs text-slate-500">圖片 (選填，無則自動產生)</span>
          <input name="image" type="file" accept="image/*" class="mt-1 block text-sm" />
        </label>
        <label class="block">
          <span class="text-xs text-slate-500">備註</span>
          <textarea name="note" rows="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
        </label>
        <div id="pointFormError" class="hidden text-xs text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2"></div>
        <div class="flex justify-end gap-2 pt-1">
          <button type="button" data-dismiss="pointModal" class="px-3 py-2 text-sm rounded-lg border border-slate-300">取消</button>
          <button id="deletePointBtn" type="button" class="hidden px-3 py-2 text-sm rounded-lg border border-rose-300 text-rose-600">刪除</button>
          <button type="submit" class="px-3 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700">
            <span data-state="idle">儲存</span><span data-state="loading" class="hidden">儲存中…</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: History form -->
  <div id="historyModal" class="hidden fixed inset-0 z-40 bg-black/40 grid place-items-center px-3">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl p-5 animate-slide-up">
      <h3 class="text-lg font-semibold" id="historyModalTitle">新增紀錄</h3>
      <form id="historyForm" class="mt-3 space-y-3">
        <input type="hidden" name="hid" />
        <div class="grid grid-cols-3 gap-2">
          <label class="block">
            <span class="text-xs text-slate-500">類型</span>
            <select name="changeType" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-2 text-sm">
              <option value="set">直接更新</option>
              <option value="earn">獲得</option>
              <option value="spend">花費</option>
            </select>
          </label>
          <label class="block col-span-2">
            <span class="text-xs text-slate-500">數量 <span class="text-rose-500">*</span></span>
            <input name="amount" type="number" min="0" step="0.01" required
                   class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
          </label>
        </div>
        <label class="block">
          <span class="text-xs text-slate-500">時間</span>
          <input name="occurredAt" type="datetime-local" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </label>
        <label class="block">
          <span class="text-xs text-slate-500">備註</span>
          <input name="note" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
        </label>
        <div id="historyFormError" class="hidden text-xs text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2"></div>
        <div class="flex justify-end gap-2 pt-1">
          <button type="button" data-dismiss="historyModal" class="px-3 py-2 text-sm rounded-lg border border-slate-300">取消</button>
          <button id="deleteHistoryBtn" type="button" class="hidden px-3 py-2 text-sm rounded-lg border border-rose-300 text-rose-600">刪除</button>
          <button type="submit" class="px-3 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700">
            <span data-state="idle">儲存</span><span data-state="loading" class="hidden">儲存中…</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Expiry Management -->
  <div id="expiryModal" class="hidden fixed inset-0 z-40 bg-black/40 grid place-items-center px-3">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl p-5 animate-slide-up max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">到期提醒管理</h3>
        <button data-dismiss="expiryModal" class="text-slate-400 hover:text-slate-600">✕</button>
      </div>

      <div class="overflow-y-auto flex-1 space-y-4 pr-1">
        <!-- List of existing expiries -->
        <div id="tlExpiries" class="hidden space-y-2 mb-4 border-b border-slate-100 pb-4">
          <div class="text-xs font-medium text-slate-500">現有提醒</div>
          <div id="tlExpiryList" class="space-y-2"></div>
        </div>

        <!-- Form to add new expiry -->
        <div>
          <div class="text-xs font-medium text-slate-500 mb-2" id="expiryModalTitle">新增提醒</div>
          <form id="expiryForm" class="space-y-3">
            <input type="hidden" name="eid" />
            <div class="grid grid-cols-2 gap-3">
              <label class="block">
                <span class="text-xs text-slate-500">到期點數 <span class="text-rose-500">*</span></span>
                <input name="amount" type="number" min="0" step="0.01" required
                       class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
              <label class="block">
                <span class="text-xs text-slate-500">到期日期 <span class="text-rose-500">*</span></span>
                <input name="expiryDate" type="date" required
                       class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
              </label>
            </div>
            <label class="block">
              <span class="text-xs text-slate-500">備註</span>
              <input name="note" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
            </label>
            <div id="expiryFormError" class="hidden text-xs text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2"></div>
            <div class="flex justify-end gap-2 pt-1">
              <button type="button" id="cancelEditExpiryBtn" class="hidden px-3 py-2 text-sm rounded-lg border border-slate-300">取消編輯</button>
              <button type="submit" class="px-3 py-2 text-sm rounded-lg bg-amber-500 text-white hover:bg-amber-600">
                <span data-state="idle">儲存</span><span data-state="loading" class="hidden">儲存中…</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="<%= asset('/js/points.js') %>"></script>
</body>
</html>
