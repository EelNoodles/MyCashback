<%
  const AUTH = { apiKey: ['API 金鑰', 'badge-green'], session: ['登入 Session', 'badge-slate'], none: ['公開', 'badge-brand'] };
  // minimal markdown: **bold**, `code`, "- " bullets, blank-line paragraphs
  function inline(t) { return t.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/`([^`]+)`/g, '<code>$1</code>'); }
  function blocks(escd) {
    return escd.split(/\n{2,}/).map(function (block) {
      const lines = block.split('\n');
      if (/^## /.test(lines[0])) return '<h3 class="mt-4 font-bold text-slate-900 dark:text-white">' + inline(lines[0].slice(3)) + '</h3>' + (lines.length > 1 ? blocks(lines.slice(1).join('\n')) : '');
      if (lines.every(function (l) { return /^\s*- /.test(l); })) return '<ul class="list-disc space-y-1 pl-5">' + lines.map(function (l) { return '<li>' + inline(l.replace(/^\s*- /, '')) + '</li>'; }).join('') + '</ul>';
      return '<p>' + inline(lines.join('<br>')) + '</p>';
    }).join('');
  }
  function md(s) {
    return blocks(String(s || '').replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }));
  }
  const base = model.base;
%>
<!DOCTYPE html>
<html lang="zh-Hant">
<head><%- include('partials/head') %></head>
<body data-auth="1">
  <%- include('partials/nav', { active }) %>
  <header class="appbar">
    <div class="appbar-inner">
      <a href="<%= url('/settings') %>" class="icon-btn -ml-2 md:hidden" aria-label="返回設定"><svg class="i"><use href="#i-chevron-left"/></svg></a>
      <div class="min-w-0 flex-1"><span class="appbar-sub">MyCashback API v<%= model.info.version %></span><h1 class="appbar-title leading-tight">API 串接文件</h1></div>
      <a href="<%= url('/api/docs/openapi.json') %>" class="btn btn-secondary btn-sm" target="_blank" rel="noopener">OpenAPI</a>
    </div>
  </header>

  <main class="page page-wide">
    <section class="card card-pad prose-doc space-y-3">
      <%- md(model.info.description) %>
      <p>伺服器網址：<code><%= base %></code></p>
    </section>

    <h2 class="section-title">快速開始</h2>
    <section class="card card-pad prose-doc space-y-4">
      <div><b>1. 建立 API 金鑰</b>：到 <a class="text-brand-600 underline" href="<%= url('/settings') %>">設定 → API 金鑰</a> 建立，金鑰（<code>mcb_</code> 開頭）只會顯示一次。</div>
      <div><b>2. 記帳系統每筆交易回報一次</b>（重送同一個 externalRef 不會重複）：
        <pre class="codeblock mt-2">curl -X POST '<%= base %>/api/ingest/card-transactions' \
  -H 'Authorization: Bearer mcb_你的金鑰' \
  -H 'Content-Type: application/json' \
  -d '{"cardName":"玉山 Pi 卡","paymentMethodName":"LINE Pay","amount":1280,"transactionAt":"2026-11-15T13:05:00+08:00","note":"全聯","externalRef":"ledger-8831"}'</pre></div>
      <div><b>3. 結帳前問「刷哪張」</b>：
        <pre class="codeblock mt-2">curl '<%= base %>/api/external/recommend?amount=1000&merchant=全聯' \
  -H 'Authorization: Bearer mcb_你的金鑰'</pre></div>
      <div><b>iPhone 捷徑（刷哪張）</b>
        <ol class="mt-1 list-decimal space-y-1 pl-5">
          <li>「要求輸入」數字 → 金額；（可選）再要求輸入文字 → 商家</li>
          <li>「取得 URL 內容」：<code><%= base %>/api/external/recommend?amount=[金額]&amp;merchant=[商家]</code>，標頭加 <code>Authorization</code> = <code>Bearer mcb_你的金鑰</code></li>
          <li>「取得辭典值」<code>best.text</code> → 「顯示結果」或「朗讀文字」</li>
        </ol>
      </div>
      <div><b>錯誤處理建議</b>：<code>422 CARD_NOT_FOUND</code> 會附上 <code>knownCards</code>，可以直接在卡片設定加「別名」解決；<code>429</code> 請依 <code>Retry-After</code> 秒數重試；網路逾時可安心用同一個 externalRef 重送。</div>
    </section>

    <h2 class="section-title">端點目錄</h2>
    <nav class="card card-pad text-sm">
      <% model.groups.forEach(function (g) { %>
        <div class="py-1"><a class="font-semibold text-brand-600 dark:text-brand-400" href="#g-<%= encodeURIComponent(g.name) %>"><%= g.name %></a> <span class="muted">（<%= g.ops.length %>）</span></div>
      <% }) %>
    </nav>

    <% model.groups.forEach(function (g) { %>
      <h2 class="section-title !normal-case" id="g-<%= encodeURIComponent(g.name) %>"><span><%= g.name %></span></h2>
      <% if (g.description) { %><p class="-mt-1 mb-2 px-1 text-[13px] muted"><%= g.description %></p><% } %>
      <div class="space-y-2">
        <% g.ops.forEach(function (op) { %>
          <details class="card group" id="<%= op.id %>">
            <summary class="flex cursor-pointer items-start gap-2 p-3">
              <span class="method method-<%= op.method %>"><%= op.method.toUpperCase() %></span>
              <span class="min-w-0 flex-1"><code class="block break-all font-mono text-[13px] font-semibold"><%= op.path %></code><span class="block text-[13px] muted"><%= op.summary %></span></span>
              <span class="badge <%= AUTH[op.auth][1] %>"><%= AUTH[op.auth][0] %></span>
            </summary>
            <div class="space-y-4 border-t border-slate-100 p-3 prose-doc dark:border-slate-800">
              <% if (op.description) { %><div class="space-y-2"><%- md(op.description) %></div><% } %>
              <% if (op.params.length) { %>
                <div><div class="mb-1 font-semibold text-slate-900 dark:text-white">參數</div>
                  <div class="overflow-x-auto"><table class="w-full text-left text-[13px]"><tbody>
                    <% op.params.forEach(function (p) { %><tr class="border-t border-slate-100 align-top dark:border-slate-800"><td class="py-1.5 pr-2"><code><%= p.name %></code><% if (p.required) { %> <span class="text-rose-600">*</span><% } %><div class="text-[11px] faint"><%= p.in === 'path' ? '路徑' : '查詢字串' %> · <%= p.type %></div></td><td class="py-1.5"><%= p.description %><% if (p.enum) { %><div class="text-[11px] faint">可用值：<%= p.enum.join(' / ') %></div><% } %></td></tr><% }) %>
                  </tbody></table></div></div>
              <% } %>
              <% if (op.bodyFields.length) { %>
                <div><div class="mb-1 font-semibold text-slate-900 dark:text-white">Request body<%= op.multipart ? '（JSON 或 multipart/form-data）' : '（JSON）' %></div>
                  <div class="overflow-x-auto"><table class="w-full text-left text-[13px]"><tbody>
                    <% op.bodyFields.forEach(function (f) { %><tr class="border-t border-slate-100 align-top dark:border-slate-800"><td class="py-1.5 pr-2"><code><%= f.name %></code><% if (f.required) { %> <span class="text-rose-600">*</span><% } %><div class="text-[11px] faint"><%= f.type %></div></td><td class="py-1.5"><%= f.description %><% if (f.enum) { %><div class="text-[11px] faint">可用值：<%= f.enum.join(' / ') %></div><% } %></td></tr><% }) %>
                  </tbody></table></div>
                  <% if (op.bodyExample) { %><pre class="codeblock mt-2"><%= op.bodyExample %></pre><% } %>
                </div>
              <% } %>
              <div><div class="mb-1 font-semibold text-slate-900 dark:text-white">回應 <span class="badge badge-green"><%= op.status %></span></div>
                <% if (op.responseFields.length) { %><details class="mb-2"><summary class="cursor-pointer text-[13px] text-brand-600">欄位說明（<%= op.responseFields.length %>）</summary><div class="overflow-x-auto"><table class="mt-1 w-full text-left text-[13px]"><tbody>
                  <% op.responseFields.forEach(function (f) { %><tr class="border-t border-slate-100 align-top dark:border-slate-800"><td class="py-1.5 pr-2"><code><%= f.name %></code><div class="text-[11px] faint"><%= f.type %></div></td><td class="py-1.5"><%= f.description %><% if (f.enum) { %><div class="text-[11px] faint">可用值：<%= f.enum.join(' / ') %></div><% } %></td></tr><% }) %>
                </tbody></table></div></details><% } %>
                <pre class="codeblock"><%= op.responseExample %></pre>
              </div>
              <% if (op.errors.length) { %>
                <div><div class="mb-1 font-semibold text-slate-900 dark:text-white">錯誤</div>
                  <ul class="space-y-1 text-[13px]"><% op.errors.forEach(function (e) { %><li><span class="badge badge-rose"><%= e.status %></span> <code><%= e.code %></code> <span class="muted"><%= e.description %></span></li><% }) %></ul></div>
              <% } %>
              <div><div class="mb-1 font-semibold text-slate-900 dark:text-white">範例</div><pre class="codeblock"><%= op.curl %></pre></div>
            </div>
          </details>
        <% }) %>
      </div>
    <% }) %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
