<!DOCTYPE html>
<html lang="zh-Hant">
<head><%- include('partials/head') %></head>
<body data-auth="1">
  <%- include('partials/nav', { active }) %>
  <header class="appbar">
    <div class="appbar-inner">
      <a href="<%= url('/transactions') %>" class="icon-btn -ml-2" aria-label="返回交易紀錄"><svg class="i"><use href="#i-chevron-left"/></svg></a>
      <h1 class="appbar-title">消費地圖</h1>
    </div>
  </header>
  <main class="page page-wide">
    <% if (!googleMapsApiKey) { %>
      <section class="card">
        <div class="empty"><svg class="i"><use href="#i-map"/></svg>
          <div class="font-semibold text-slate-700 dark:text-slate-200">尚未設定 Google Maps 金鑰</div>
          <div class="mt-1">請在伺服器環境變數設定 <code class="rounded bg-slate-100 px-1 font-mono dark:bg-slate-800">GOOGLE_MAPS_API_KEY</code>（需啟用 Maps JavaScript API），重新整理後即可看到消費地點與熱力圖。</div>
          <div class="mt-1">交易記錄時按「使用目前位置」就會帶入經緯度。</div>
        </div>
      </section>
    <% } else { %>
      <section class="card card-pad space-y-3">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <select id="cardFilter" class="select !min-h-[38px] !w-auto"><option value="">全部卡片</option></select>
          <label class="flex items-center gap-2"><input id="heatmapToggle" type="checkbox" checked class="h-4 w-4 accent-brand-600">熱力圖</label>
          <label class="flex items-center gap-2"><input id="markersToggle" type="checkbox" checked class="h-4 w-4 accent-brand-600">地點標記</label>
          <span id="mapStats" class="ml-auto text-[13px] muted"></span>
        </div>
        <div id="map" class="w-full overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700" style="height: 65vh; min-height: 360px;"></div>
      </section>
    <% } %>
  </main>
  <%- include('partials/footer') %>
  <% if (googleMapsApiKey) { %>
    <script>window.GOOGLE_MAPS_API_KEY = <%- JSON.stringify(googleMapsApiKey) %>;</script>
    <script src="<%= asset('/js/transactions-map.js') %>"></script>
  <% } %>
</body>
</html>
