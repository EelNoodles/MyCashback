<!DOCTYPE html>
<html lang="zh-Hant">
<head><%- include('partials/head') %></head>
<body class="min-h-screen bg-gradient-to-b from-brand-50 to-slate-50 dark:from-slate-900 dark:to-slate-950">
  <main class="grid min-h-screen place-items-center px-4 py-10">
    <div class="w-full max-w-sm">
      <div class="mb-6 text-center">
        <div class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br from-brand-500 to-indigo-600 text-xl font-extrabold text-white shadow-lift">C$</div>
        <h1 class="mt-4 text-2xl font-extrabold tracking-tight">MyCashback</h1>
        <p class="mt-1 text-sm muted">信用卡回饋、刷卡建議與點數管理</p>
      </div>
      <form id="loginForm" class="card card-pad space-y-3" autocomplete="on">
        <label class="field"><span class="label">Email</span><input id="email" name="email" type="email" required autocomplete="email" inputmode="email" class="input"></label>
        <label class="field"><span class="label">密碼</span><input id="password" name="password" type="password" required minlength="6" autocomplete="current-password" class="input"></label>
        <button id="loginBtn" type="submit" class="btn btn-primary btn-block">
          <span data-state="idle">登入</span><span data-state="loading" class="hidden">登入中…</span>
        </button>
        <div id="loginError" class="error-box hidden"></div>
      </form>
      <p class="mt-4 text-center text-xs muted">第一次使用？輸入新的 Email 與密碼會自動建立帳號。</p>
    </div>
  </main>
  <script>window.FIREBASE_CONFIG = <%- JSON.stringify(firebaseConfig) %>;</script>
  <script type="module" src="<%= asset('/js/login.js') %>"></script>
</body>
</html>
