<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <%- include('partials/head', { title: title || 'Error' }) %>
</head>
<body class="min-h-screen bg-slate-50 grid place-items-center px-4">
  <div class="bg-white max-w-md w-full rounded-2xl shadow-sm border border-slate-100 p-6 text-center">
    <div class="text-5xl font-bold text-brand-600"><%= status %></div>
    <p class="mt-3 text-slate-600 text-sm"><%= message %></p>
    <a href="<%= url('/') %>" class="inline-block mt-5 px-4 py-2 rounded-lg bg-brand-600 text-white text-sm hover:bg-brand-700">回到首頁</a>
  </div>
</body>
</html>
