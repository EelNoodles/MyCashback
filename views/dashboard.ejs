<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <%- include('partials/head', { title: title }) %>
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 pb-20 sm:pb-0">
  <%- include('partials/nav', { active: active }) %>

  <main class="max-w-6xl mx-auto px-4 py-6 space-y-6">
    <header class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-semibold">點數總覽</h1>
        <p class="text-sm text-slate-500">所有點數/載具的目前餘額</p>
      </div>
      <div class="flex gap-2">
        <a href="<%= url('/points') %>" class="px-3 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700">管理點數</a>
      </div>
    </header>

    <!-- Total balance hero -->
    <section class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 flex items-baseline justify-between gap-3 flex-wrap">
      <div>
        <div class="text-[11px] text-slate-500 uppercase tracking-widest">點數總資產</div>
        <div class="text-3xl sm:text-4xl font-bold text-brand-700 mt-1" data-stat="totalBalance">—</div>
      </div>
      <div class="text-xs text-slate-400">所有點數種類加總（不同單位混合計算）</div>
    </section>

    <!-- Summary stat cards -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-3" id="summaryStats">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
        <div class="text-xs text-slate-500">點數種類</div>
        <div class="text-2xl font-semibold mt-1" data-stat="count">—</div>
      </div>
      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
        <div class="text-xs text-slate-500">本月新增</div>
        <div class="text-2xl font-semibold mt-1 text-emerald-600" data-stat="earned">—</div>
      </div>
      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
        <div class="text-xs text-slate-500">本月花費</div>
        <div class="text-2xl font-semibold mt-1 text-rose-600" data-stat="spent">—</div>
      </div>
      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
        <div class="text-xs text-slate-500">有效活動</div>
        <div class="text-2xl font-semibold mt-1 text-brand-600" data-stat="activeEvents">—</div>
      </div>
    </section>

    <!-- Point Expiry Alerts -->
    <section id="expiryAlertSection" class="hidden">
      <h2 class="text-lg font-semibold mb-3 flex items-center gap-2">
        <span class="text-amber-500">⚠️</span> 點數到期提醒
      </h2>
      <div id="expiryAlerts" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
    </section>

    <!-- Points cards grid -->
    <section>
      <h2 class="text-lg font-semibold mb-3">點數卡片</h2>
      <div id="pointsGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        <div class="text-sm text-slate-400 col-span-full py-4 flex items-center justify-center gap-2" data-loading><svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> 載入中…</div>
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold mb-3">所有回饋活動</h2>
      <div id="expiringEvents" class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="text-sm text-slate-400 col-span-full py-4 flex items-center justify-center gap-2" data-loading><svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> 載入中…</div>
      </div>
    </section>
  </main>

  <!-- Modal: Event Details -->
  <div id="eventDetailsModal" class="hidden fixed inset-0 z-40 bg-black/40 grid place-items-center px-3">
    <div class="bg-white w-full min-w-0 max-w-md rounded-2xl shadow-xl p-5 animate-slide-up max-h-[90vh] flex flex-col">
      <div class="flex justify-between items-start mb-4 gap-3">
        <h3 class="text-lg font-semibold truncate min-w-0" id="eventDetailsTitle">活動詳情</h3>
        <button data-dismiss="eventDetailsModal" class="flex-shrink-0 text-slate-400 hover:text-slate-600">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="overflow-y-auto flex-1 min-w-0 space-y-4" id="eventDetailsContent">
        <!-- Content injected via JS -->
      </div>
      <div class="mt-5 pt-4 border-t flex justify-end gap-2 shrink-0">
        <a id="eventDetailsEditBtn" href="#" class="px-4 py-2 text-sm rounded-lg bg-brand-600 text-white hover:bg-brand-700">前往編輯</a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="<%= asset('/js/dashboard.js') %>"></script>
</body>
</html>
