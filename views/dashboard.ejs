<!DOCTYPE html>
<html lang="zh-Hant">
<head><%- include('partials/head') %></head>
<body data-auth="1">
  <%- include('partials/nav', { active }) %>
  <header class="appbar">
    <div class="appbar-inner">
      <div class="min-w-0 flex-1">
        <span class="appbar-sub" id="todayLabel">&nbsp;</span>
        <h1 class="appbar-title leading-tight">總覽</h1>
      </div>
      <a href="<%= url('/settings') %>" class="icon-btn md:hidden" aria-label="設定"><svg class="i"><use href="#i-cog"/></svg></a>
    </div>
  </header>

  <main class="page">
    <section class="hero" id="hero" aria-live="polite">
      <div class="relative z-10">
        <div class="text-sm font-medium text-white/80">本期應得回饋</div>
        <div class="mt-1 text-4xl font-extrabold tracking-tight money" id="heroReward"><span class="inline-block h-9 w-32 animate-pulse rounded-lg bg-white/20"></span></div>
        <div class="mt-1 text-sm text-white/85" id="heroRemaining">&nbsp;</div>
        <div class="mt-4 grid grid-cols-3 gap-2 border-t border-white/15 pt-3 text-xs text-white/75">
          <div><div>本月刷卡</div><div class="mt-0.5 text-[15px] font-bold text-white money" id="heroSpend">—</div></div>
          <div><div>本月入帳</div><div class="mt-0.5 text-[15px] font-bold text-white money" id="heroReceived">—</div></div>
          <div><div>進行中活動</div><div class="mt-0.5 text-[15px] font-bold text-white" id="heroEvents">—</div></div>
        </div>
      </div>
    </section>

    <section class="mt-4 grid grid-cols-4 gap-2" aria-label="快速動作">
      <a href="<%= url('/recommend') %>" class="card card-link flex flex-col items-center gap-1.5 py-3 text-xs font-semibold"><span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-brand-300"><svg class="i"><use href="#i-bolt"/></svg></span>刷哪張</a>
      <a href="<%= url('/transactions?new=1') %>" class="card card-link flex flex-col items-center gap-1.5 py-3 text-xs font-semibold"><span class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-300"><svg class="i"><use href="#i-plus"/></svg></span>記一筆</a>
      <a href="<%= url('/cashback?tab=audit') %>" class="card card-link flex flex-col items-center gap-1.5 py-3 text-xs font-semibold"><span class="grid h-10 w-10 place-items-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-500/15 dark:text-amber-300"><svg class="i"><use href="#i-audit"/></svg></span>核對入帳</a>
      <a href="<%= url('/cashback?new=1') %>" class="card card-link flex flex-col items-center gap-1.5 py-3 text-xs font-semibold"><span class="grid h-10 w-10 place-items-center rounded-xl bg-violet-50 text-violet-600 dark:bg-violet-500/15 dark:text-violet-300"><svg class="i"><use href="#i-gift"/></svg></span>加活動</a>
    </section>

    <section id="attentionSection" hidden>
      <h2 class="section-title"><span>需要注意</span><span class="badge badge-rose" id="attentionCount"></span></h2>
      <div class="card overflow-hidden"><div class="list" id="attentionList"></div></div>
    </section>

    <section>
      <h2 class="section-title"><span>本期進行中活動</span><a href="<%= url('/cashback') %>">全部</a></h2>
      <div id="eventsList" class="grid gap-3 md:grid-cols-2"><div class="skeleton h-28"></div><div class="skeleton h-28"></div></div>
    </section>

    <section>
      <h2 class="section-title"><span>點數</span><a href="<%= url('/points') %>">管理</a></h2>
      <a href="<%= url('/points') %>" class="card card-link card-pad grid grid-cols-3 gap-3" id="pointsCard">
        <div><div class="stat-label">點數總價值</div><div class="stat-value money" id="ptValue">—</div></div>
        <div><div class="stat-label">本月獲得</div><div class="stat-value text-emerald-600 dark:text-emerald-400 money" id="ptEarned">—</div></div>
        <div><div class="stat-label">本月使用</div><div class="stat-value text-rose-600 dark:text-rose-400 money" id="ptSpent">—</div></div>
      </a>
    </section>

    <section>
      <h2 class="section-title"><span>回饋紀錄</span></h2>
      <div class="card card-pad grid grid-cols-2 gap-3">
        <div><div class="stat-label">上月刷卡</div><div class="stat-value money" id="lastMonthSpend">—</div></div>
        <div><div class="stat-label">今年已入帳回饋</div><div class="stat-value text-emerald-600 dark:text-emerald-400 money" id="yearReceived">—</div></div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="<%= asset('/js/dashboard.js') %>"></script>
</body>
</html>
