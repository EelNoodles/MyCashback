<!DOCTYPE html>
<html lang="zh-Hant">
<head><%- include('partials/head') %></head>
<body data-auth="1">
  <%- include('partials/nav', { active }) %>
  <header class="appbar">
    <div class="appbar-inner">
      <h1 class="appbar-title">回饋活動</h1>
      <button type="button" class="icon-btn" id="aiParseBtn" aria-label="AI 解析活動文字" title="AI 解析活動文字"><svg class="i"><use href="#i-sparkles"/></svg></button>
      <button type="button" class="icon-btn icon-btn-primary" id="newEventBtn" aria-label="新增活動" title="新增活動"><svg class="i"><use href="#i-plus"/></svg></button>
    </div>
  </header>

  <main class="page">
    <div class="seg" id="tabs" role="tablist">
      <button type="button" data-tab="list" aria-pressed="true">活動</button>
      <button type="button" data-tab="audit" aria-pressed="false">核對入帳</button>
      <button type="button" data-tab="ai" aria-pressed="false">AI 問答</button>
    </div>

    <!-- ── 活動 ── -->
    <section id="tab-list" class="mt-3">
      <div class="flex gap-2">
        <div class="input-icon flex-1">
          <svg class="i"><use href="#i-search"/></svg>
          <input id="qInput" class="input" type="search" placeholder="搜尋活動、卡片、支付、商家" enterkeyhint="search" />
        </div>
        <button type="button" class="btn btn-secondary relative !px-3" id="filterBtn" aria-label="篩選與排序">
          <svg class="i"><use href="#i-filter"/></svg>
          <span id="filterDot" class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-brand-600" hidden></span>
        </button>
      </div>
      <div class="chips mt-3" id="statusChips">
        <button type="button" class="chip" data-status="ongoing">進行中</button>
        <button type="button" class="chip" data-status="upcoming">即將開始</button>
        <button type="button" class="chip" data-status="active">未結束</button>
        <button type="button" class="chip" data-status="expired">已結束</button>
        <button type="button" class="chip" data-status="all">全部</button>
      </div>
      <div id="eventsList" class="mt-3 grid gap-3 md:grid-cols-2"></div>
    </section>

    <!-- ── 核對入帳 ── -->
    <section id="tab-audit" class="mt-3" hidden>
      <p class="px-1 text-[13px] muted">依交易紀錄計算「應得」回饋，跟銀行實際入帳比對，看看有沒有少給。</p>
      <div class="chips mt-3" id="rangeChips">
        <button type="button" class="chip" data-range="cycle">本期</button>
        <button type="button" class="chip" data-range="prevCycle">上一期（已結算）</button>
        <button type="button" class="chip" data-range="thisMonth">本月</button>
        <button type="button" class="chip" data-range="lastMonth">上月</button>
        <button type="button" class="chip" data-range="custom">自訂</button>
      </div>
      <div id="customRange" class="mt-3 grid grid-cols-2 gap-2" hidden>
        <label class="field"><span class="label">起</span><input type="date" class="input" id="raFrom"></label>
        <label class="field"><span class="label">迄（含）</span><input type="date" class="input" id="raTo"></label>
      </div>
      <div class="card card-pad mt-3 grid grid-cols-3 gap-2 text-center" id="auditTotals">
        <div><div class="stat-label">應得</div><div class="stat-value money" data-t="expected">—</div></div>
        <div><div class="stat-label">已入帳</div><div class="stat-value money" data-t="received">—</div></div>
        <div><div class="stat-label">消費</div><div class="stat-value money" data-t="spend">—</div></div>
      </div>
      <div id="auditList" class="mt-3 space-y-3"></div>
    </section>

    <!-- ── AI 問答 ── -->
    <section id="tab-ai" class="mt-3" hidden>
      <form id="aiSearchForm" class="card card-pad space-y-3">
        <label class="field">
          <span class="label">想刷什麼？</span>
          <input id="aiQuery" class="input" maxlength="100" placeholder="例如：外送、加油、出國、訂房" enterkeyhint="search" required>
          <span class="hint">AI 會讀你記錄的進行中活動來推薦。要精確試算金額，請用「刷哪張」。</span>
        </label>
        <div class="grid grid-cols-2 gap-2">
          <label class="field"><span class="label">模型</span><select id="aiModel" class="select"><option value="">載入中…</option></select></label>
          <label class="field"><span class="label">聯網補充</span>
            <span class="flex min-h-[46px] items-center gap-3"><input type="checkbox" id="aiWeb" class="sr-only"><span class="switch" data-for="aiWeb"></span><span class="text-sm muted">較慢</span></span>
          </label>
        </div>
        <button class="btn btn-primary btn-block" id="aiSearchBtn" type="submit"><svg class="i"><use href="#i-sparkles"/></svg>詢問 AI</button>
      </form>
      <div id="aiResults" class="mt-3 space-y-3"></div>
    </section>
  </main>

  <!-- Filter sheet -->
  <div class="sheet-root" id="filterSheet" hidden role="dialog" aria-modal="true" aria-label="篩選">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title">篩選與排序</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <div class="sheet-body space-y-4">
        <label class="field"><span class="label">卡片</span><select class="select" id="fCard"><option value="">全部卡片</option></select></label>
        <label class="field"><span class="label">支付方式</span><select class="select" id="fPm"><option value="">全部</option><option value="none">適用直接刷卡</option></select></label>
        <label class="field"><span class="label">排序</span>
          <select class="select" id="fSort">
            <option value="deadline">快截止的在前</option>
            <option value="remaining">還可拿最多的在前</option>
            <option value="rate">回饋率高→低</option>
            <option value="title">名稱</option>
          </select>
        </label>
        <label class="field"><span class="label">分組</span>
          <select class="select" id="fGroup">
            <option value="none">不分組</option>
            <option value="card">依卡片</option>
            <option value="paymentMethod">依支付方式</option>
          </select>
        </label>
      </div>
      <div class="sheet-footer"><button type="button" class="btn btn-secondary flex-1" id="fReset">清除</button><button type="button" class="btn btn-primary flex-1" data-close>完成</button></div>
    </div>
  </div>

  <!-- Event form sheet -->
  <div class="sheet-root" id="eventSheet" hidden role="dialog" aria-modal="true" aria-labelledby="eventSheetTitle">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet sheet-full sheet-lg">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title" id="eventSheetTitle">新增回饋活動</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <form id="eventForm" class="sheet-body space-y-4" novalidate>
        <input type="hidden" name="id">
        <div class="form-section">
          <label class="field"><span class="label">活動名稱 *</span><input name="title" class="input" maxlength="255" required placeholder="例如：Pi 卡綁 LINE Pay 5%"></label>
          <div class="grid grid-cols-2 gap-2">
            <label class="field"><span class="label">開始日</span><input name="startDate" type="date" class="input"></label>
            <label class="field"><span class="label">結束日</span><input name="endDate" type="date" class="input"></label>
          </div>
          <label class="field"><span class="label">活動網址</span><input name="sourceUrl" type="url" inputmode="url" class="input" placeholder="https://"></label>
        </div>

        <div class="form-section">
          <div class="form-section-title">回饋</div>
          <div class="seg" id="rewardModeSeg">
            <button type="button" data-mode="percent" aria-pressed="true">百分比 %</button>
            <button type="button" data-mode="fixed" aria-pressed="false">固定金額</button>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <label class="field" data-show="percent"><span class="label">回饋 %</span><input name="cashbackPercent" type="number" inputmode="decimal" step="0.001" min="0" max="100" class="input" placeholder="5"></label>
            <label class="field" data-show="fixed" hidden><span class="label">每次回饋</span><input name="cashbackFixed" type="number" inputmode="decimal" step="0.01" min="0" class="input" placeholder="50"></label>
            <label class="field"><span class="label">回饋類型</span>
              <select name="rewardType" class="select"><option value="cash">現金</option><option value="point">點數</option><option value="coupon">折價券</option><option value="other">其他</option></select>
            </label>
          </div>
          <label class="field"><span class="label">每期回饋上限</span><input name="maxReward" type="number" inputmode="decimal" step="0.01" min="0" class="input" placeholder="不限"></label>
          <div>
            <label class="field"><span class="label">門檻金額</span><input name="minimumSpend" type="number" inputmode="decimal" step="0.01" min="0" class="input" placeholder="無門檻"></label>
            <div class="seg mt-2" id="scopeSeg">
              <button type="button" data-scope="perTransaction" aria-pressed="true">單筆滿額</button>
              <button type="button" data-scope="cycleTotal" aria-pressed="false">本期累積滿額</button>
            </div>
            <span class="hint" id="scopeHint"></span>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title">重置週期</div>
          <div class="grid grid-cols-2 gap-2">
            <label class="field"><span class="label">週期</span>
              <select name="cycleType" class="select"><option value="none">不重置（整個活動期間）</option><option value="monthly">每月</option><option value="weekly">每週</option><option value="biweekly">每兩週</option></select>
            </label>
            <label class="field" id="anchorField"><span class="label" id="anchorLabel">每月幾號重置</span>
              <select name="cycleAnchorDay" class="select"></select>
            </label>
          </div>
          <span class="hint" id="cycleHint"></span>
        </div>

        <div class="form-section">
          <div class="form-section-title">適用卡片與支付</div>
          <div><span class="label">卡片（可複選）</span><div class="flex flex-wrap gap-2" id="cardPick"></div></div>
          <div><span class="label">支付方式（不選＝只算直接刷卡）</span><div class="flex flex-wrap gap-2" id="pmPick"></div></div>
          <label class="check" id="unspecWrap"><input type="checkbox" name="matchUnspecifiedPayment"><span class="text-sm"><b>直接刷卡也算</b><span class="hint !mt-0.5">除了上面的支付方式，沒用電子支付的交易也計入</span></span></label>
        </div>

        <div class="form-section">
          <div class="form-section-title">商家條件</div>
          <label class="flex items-center justify-between gap-3"><span class="text-sm"><b>限定商家</b><span class="hint !mt-0.5">交易備註需包含其中一個關鍵字才算</span></span><input type="checkbox" name="requireMerchantMatch" id="reqMerchant" class="sr-only"><span class="switch" data-for="reqMerchant"></span></label>
          <div id="merchantBox" hidden>
            <textarea name="merchantKeywords" rows="3" class="textarea" placeholder="每行一個，例如&#10;CAMA&#10;全家"></textarea>
            <button type="button" class="btn btn-tonal btn-sm mt-2" data-ai-kw="merchantKeywords"><svg class="i i-sm"><use href="#i-sparkles"/></svg>AI 整理商家清單</button>
          </div>
          <label class="flex items-center justify-between gap-3"><span class="text-sm"><b>排除商家</b><span class="hint !mt-0.5">包含任一關鍵字就完全不算（優先於其他條件）</span></span><input type="checkbox" name="excludeMerchantMatch" id="excMerchant" class="sr-only"><span class="switch" data-for="excMerchant"></span></label>
          <div id="excludeBox" hidden>
            <textarea name="excludeMerchantKeywords" rows="3" class="textarea" placeholder="每行一個，例如&#10;全聯&#10;繳費"></textarea>
            <button type="button" class="btn btn-tonal btn-sm mt-2" data-ai-kw="excludeMerchantKeywords"><svg class="i i-sm"><use href="#i-sparkles"/></svg>AI 整理排除清單</button>
          </div>
        </div>

        <div class="form-section">
          <label class="flex items-center justify-between gap-3"><span class="text-sm"><b>需要登錄</b><span class="hint !mt-0.5">首頁會提醒你還沒登錄的活動</span></span><input type="checkbox" name="requiresRegistration" id="reqReg" class="sr-only"><span class="switch" data-for="reqReg"></span></label>
          <label class="field" id="regDateField" hidden><span class="label">登錄日期（留空＝還沒登錄）</span><input name="registeredAt" type="date" class="input"></label>
        </div>

        <details class="form-section">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-bold">進階：回饋怎麼算<svg class="i i-sm faint"><use href="#i-chevron-down"/></svg></summary>
          <div class="mt-3 space-y-3">
            <label class="field"><span class="label">計算方式</span><select name="rewardCalcMode" class="select"><option value="aggregate">本期消費加總後一次計算（多數活動）</option><option value="perTransaction">每筆分別計算後加總</option></select></label>
            <div class="grid grid-cols-2 gap-2">
              <label class="field"><span class="label">捨入</span><select name="rewardRounding" class="select"><option value="round">四捨五入</option><option value="floor">無條件捨去</option></select></label>
              <label class="field"><span class="label">算到小數第幾位</span><select name="rewardPrecision" class="select"><option value="0">整數</option><option value="1">1 位</option><option value="2">2 位</option><option value="3">3 位</option></select></label>
            </div>
          </div>
        </details>

        <div class="form-section">
          <label class="field"><span class="label">備註 / 注意事項</span><textarea name="note" rows="2" class="textarea" placeholder="例如：名額 10 萬名、需綁定帳戶"></textarea></label>
          <label class="field"><span class="label">活動原文</span><textarea name="description" rows="3" class="textarea"></textarea></label>
        </div>
        <div class="error-box" id="eventFormError" hidden></div>
      </form>
      <div class="sheet-footer">
        <button type="button" class="btn btn-danger !px-3" id="deleteEventBtn" hidden aria-label="刪除"><svg class="i"><use href="#i-trash"/></svg></button>
        <button type="button" class="btn btn-secondary flex-1" data-close>取消</button>
        <button type="submit" form="eventForm" class="btn btn-primary flex-[2]" id="saveEventBtn">儲存</button>
      </div>
    </div>
  </div>

  <!-- Receipt sheet -->
  <div class="sheet-root" id="receiptSheet" hidden role="dialog" aria-modal="true" aria-labelledby="receiptTitle">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title" id="receiptTitle">記錄實際入帳</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <form id="receiptForm" class="sheet-body space-y-3" novalidate>
        <input type="hidden" name="eventId"><input type="hidden" name="rid">
        <div class="rounded-xl bg-slate-50 p-3 text-sm dark:bg-slate-800/60" id="receiptInfo"></div>
        <label class="field"><span class="label">實際入帳金額 *</span><input name="receivedAmount" type="number" inputmode="decimal" step="0.01" min="0" class="input input-lg money" required></label>
        <label class="field"><span class="label">入帳日</span><input name="receivedDate" type="date" class="input"></label>
        <div class="grid grid-cols-2 gap-2">
          <label class="field"><span class="label">核對期間起</span><input name="periodStart" type="date" class="input"></label>
          <label class="field"><span class="label">迄（含）</span><input name="periodEnd" type="date" class="input"></label>
        </div>
        <label class="field"><span class="label">備註</span><input name="note" class="input" maxlength="500" placeholder="例如：11 月帳單折抵"></label>
        <div class="error-box" id="receiptError" hidden></div>
      </form>
      <div class="sheet-footer">
        <button type="button" class="btn btn-danger !px-3" id="deleteReceiptBtn" hidden aria-label="刪除"><svg class="i"><use href="#i-trash"/></svg></button>
        <button type="button" class="btn btn-secondary flex-1" data-close>取消</button>
        <button type="submit" form="receiptForm" class="btn btn-primary flex-[2]">儲存</button>
      </div>
    </div>
  </div>

  <!-- AI parse sheet -->
  <div class="sheet-root" id="aiParseSheet" hidden role="dialog" aria-modal="true" aria-label="AI 解析活動">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet sheet-lg">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title">AI 解析活動文字</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <div class="sheet-body space-y-3">
        <p class="text-sm muted">貼上銀行或支付的活動說明，AI 會幫你填好表單，存檔前可以再檢查修改。</p>
        <textarea id="aiParseInput" rows="8" class="textarea" placeholder="例如：玉山 Pi 卡 10/1-12/31 綁定 LINE Pay 單筆滿 200 享 5% 回饋，每月上限 300 元，需登錄"></textarea>
        <label class="field"><span class="label">模型</span><select id="aiParseModel" class="select"><option value="">載入中…</option></select></label>
        <div class="error-box" id="aiParseError" hidden></div>
      </div>
      <div class="sheet-footer"><button type="button" class="btn btn-secondary flex-1" data-close>取消</button><button type="button" class="btn btn-primary flex-[2]" id="aiParseRun"><svg class="i"><use href="#i-sparkles"/></svg>解析並填入</button></div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="<%= asset('/js/cashback.js') %>"></script>
</body>
</html>
