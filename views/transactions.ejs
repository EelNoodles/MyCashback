<!DOCTYPE html>
<html lang="zh-Hant">
<head><%- include('partials/head') %></head>
<body data-auth="1">
  <%- include('partials/nav', { active }) %>
  <header class="appbar">
    <div class="appbar-inner">
      <h1 class="appbar-title">交易紀錄</h1>
      <a href="<%= url('/transactions/map') %>" class="icon-btn" aria-label="消費地圖" title="消費地圖"><svg class="i"><use href="#i-map"/></svg></a>
      <button type="button" class="icon-btn icon-btn-primary hidden md:grid" id="newTxnBtnTop" aria-label="新增交易"><svg class="i"><use href="#i-plus"/></svg></button>
    </div>
  </header>

  <main class="page">
    <div class="flex gap-2">
      <div class="input-icon flex-1">
        <svg class="i"><use href="#i-search"/></svg>
        <input id="qInput" class="input" type="search" placeholder="搜尋商家、卡片、支付" enterkeyhint="search" />
      </div>
      <button type="button" class="btn btn-secondary relative !px-3" id="filterBtn" aria-label="篩選">
        <svg class="i"><use href="#i-filter"/></svg>
        <span id="filterDot" class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-brand-600" hidden></span>
      </button>
    </div>
    <div class="chips mt-3" id="rangeChips">
      <button type="button" class="chip" data-range="">全部</button>
      <button type="button" class="chip" data-range="thisMonth">本月</button>
      <button type="button" class="chip" data-range="lastMonth">上月</button>
      <button type="button" class="chip" data-range="last30">近 30 天</button>
      <button type="button" class="chip" data-range="custom">自訂日期</button>
    </div>

    <div class="card card-pad mt-3 flex items-center justify-between" id="summary">
      <div><div class="stat-label" id="summaryLabel">全部交易</div><div class="stat-value money" id="summaryTotal">—</div></div>
      <div class="text-right"><div class="stat-label">筆數</div><div class="stat-value" id="summaryCount">—</div></div>
    </div>

    <div id="txnList" class="mt-3 space-y-4"></div>
    <div class="mt-4 flex justify-center"><button type="button" class="btn btn-secondary" id="moreBtn" hidden>載入更多</button></div>
  </main>

  <button type="button" class="fab" id="fab" aria-label="新增交易"><svg class="i i-lg"><use href="#i-plus"/></svg></button>

  <!-- Filter sheet -->
  <div class="sheet-root" id="filterSheet" hidden role="dialog" aria-modal="true" aria-label="篩選交易">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title">篩選</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <div class="sheet-body space-y-4">
        <label class="field"><span class="label">卡片</span><select class="select" id="fCard"><option value="">全部卡片</option></select></label>
        <label class="field"><span class="label">支付方式</span><select class="select" id="fPm"><option value="">全部</option><option value="none">直接刷卡（未用電子支付）</option></select></label>
        <div class="grid grid-cols-2 gap-2">
          <label class="field"><span class="label">日期起</span><input type="date" class="input" id="fFrom"></label>
          <label class="field"><span class="label">日期迄</span><input type="date" class="input" id="fTo"></label>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <label class="field"><span class="label">金額下限</span><input type="number" inputmode="decimal" class="input" id="fMin" min="0"></label>
          <label class="field"><span class="label">金額上限</span><input type="number" inputmode="decimal" class="input" id="fMax" min="0"></label>
        </div>
        <label class="field"><span class="label">來源</span><select class="select" id="fSource"><option value="">全部</option><option value="api">API 回報</option><option value="manual">手動新增</option></select></label>
      </div>
      <div class="sheet-footer"><button type="button" class="btn btn-secondary flex-1" id="fReset">清除</button><button type="button" class="btn btn-primary flex-1" id="fApply">套用</button></div>
    </div>
  </div>

  <!-- Transaction form sheet -->
  <div class="sheet-root" id="txnSheet" hidden role="dialog" aria-modal="true" aria-labelledby="txnTitle">
    <div class="sheet-backdrop" data-close></div>
    <div class="sheet sheet-lg">
      <div class="sheet-handle"></div>
      <div class="sheet-header"><h2 class="sheet-title" id="txnTitle">記一筆</h2><button type="button" class="icon-btn" data-close aria-label="關閉"><svg class="i"><use href="#i-x"/></svg></button></div>
      <form id="txnForm" class="sheet-body space-y-4" novalidate>
        <input type="hidden" name="id">
        <label class="field">
          <span class="label">金額 *</span>
          <div class="relative">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-xl font-bold text-slate-400">NT$</span>
            <input name="amount" class="input input-lg pl-16 money" type="number" inputmode="decimal" step="0.01" min="0.01" required placeholder="0">
          </div>
        </label>
        <div><span class="label">卡片 *</span><div class="flex flex-wrap gap-2" id="cardPick"></div></div>
        <div><span class="label">支付方式</span><div class="flex flex-wrap gap-2" id="pmPick"></div></div>
        <label class="field">
          <span class="label">商家 / 備註</span>
          <input name="note" class="input" maxlength="255" list="noteList" placeholder="例如：全聯 信義店">
          <datalist id="noteList"></datalist>
          <span class="hint">商家名稱會用來比對「限定商家 / 排除商家」</span>
        </label>
        <label class="field"><span class="label">交易時間</span><input name="transactionAt" type="datetime-local" class="input"></label>
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="label !mb-0">消費地點</span>
            <button type="button" class="btn btn-tonal btn-xs" id="geoBtn"><svg class="i i-sm"><use href="#i-pin"/></svg>使用目前位置</button>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <input name="latitude" type="number" step="any" class="input" placeholder="緯度" inputmode="decimal">
            <input name="longitude" type="number" step="any" class="input" placeholder="經度" inputmode="decimal">
          </div>
        </div>
        <div id="txnMatched"></div>
        <div class="error-box" id="txnError" hidden></div>
      </form>
      <div class="sheet-footer">
        <button type="button" class="btn btn-danger !px-3" id="deleteTxnBtn" hidden aria-label="刪除"><svg class="i"><use href="#i-trash"/></svg></button>
        <button type="button" class="btn btn-secondary flex-1" data-close>取消</button>
        <button type="submit" form="txnForm" class="btn btn-primary flex-[2]" id="saveTxnBtn">儲存</button>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="<%= asset('/js/transactions.js') %>"></script>
</body>
</html>
