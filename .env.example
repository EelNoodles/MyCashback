# ===== Application =====
NODE_ENV=development
PORT=3000

# Base URL prefix when the app is mounted on a sub-path. Examples:
#   BASE_URL=        (root deploy)
#   BASE_URL=/myApp  (mounted under /myApp)
BASE_URL=

# Random string used to sign session cookies / cookie-parser
SESSION_SECRET=please-change-me-to-a-long-random-string

# ===== Database (MySQL) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mycashback
DB_USER=root
DB_PASSWORD=
# Set to "true" to log every SQL query (dev only)
DB_LOGGING=false

# ===== Firebase =====
# Path to the Firebase Admin service-account JSON file.
# DO NOT commit the JSON itself; the path is read at runtime.
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Firebase Web SDK config (exposed to the browser on /login).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Required for Firebase Cloud Messaging (push notifications). Without it the
# browser throws "Messaging: Missing App configuration value: messagingSenderId".
FIREBASE_MESSAGING_SENDER_ID=
# Web Push certificate key pair from Firebase Console > Cloud Messaging.
# Needed for getToken() to obtain an FCM registration token.
FIREBASE_VAPID_KEY=

# Session cookie lifetime in milliseconds (default 5 days)
SESSION_COOKIE_MAX_AGE=432000000

# ===== Google Gemini =====
# Fallback key used when a signed-in user has not added a personal key via
# the in-app "AI 金鑰" management UI. Optional if every user supplies their own.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Secret used to encrypt user-stored API keys at rest (AES-256-GCM).
# Falls back to SESSION_SECRET if unset. Set this to a long random string
# in production and DO NOT change it once keys have been stored.
AI_KEY_ENC_SECRET=

# ===== Logging =====
LOG_LEVEL=info
LOG_DIR=./logs
